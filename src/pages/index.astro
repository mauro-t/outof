---
import Layout from "../components/layout/layout.astro";
import BuzzPhrase from "../components/ui/buzz-phrase.astro";
import HomepageHero from "../components/ui/homepage-hero.astro";
import HomepageProjects from "../components/ui/homepage-projects.astro";
import OurServices from "../components/ui/our-services.astro";
import NewsletterBox from "../components/ui/newsletter-box.astro";
import Mask from "../components/global/mask.astro";
---

<Layout>
  <HomepageHero />
  <div data-section class="relative h-screen w-full overflow-hidden">
    <picture>
      <source srcset="/hp-mobile.jpg" media="(max-width: 600px)" />
      <img
        src="/hp-desktop.jpg"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />
    </picture>
  </div>
  <div
    data-section
    class="relative bg-white px-3 py-10 md:px-5 md:py-17 dark:bg-black"
  >
    <BuzzPhrase />
    <Mask invert />
  </div>
  <OurServices isHomepage />
  <HomepageProjects />
  <div
    data-section="last"
    class="relative bg-white not-md:h-screen dark:bg-black"
  >
    <video
      class="absolute inset-0 h-full w-full object-cover md:static"
      src="/mock-images/placeholder-video.mp4"
      muted
      playsinline
      autoplay
      loop></video>
    <div
      class="sticky top-[calc(var(--header-height)+12px)] left-0 px-3 py-3 md:absolute md:top-10 md:left-10"
    >
      <NewsletterBox />
    </div>
  </div>
</Layout>

---
import { sanityClient } from "sanity:client";

import Layout from "../components/layout/layout.astro";
import ContactUs from "../components/ui/contact-us.astro";
import OurServices from "../components/ui/our-services.astro";
import ProjectsSlider from "../components/ui/projects-slider.astro";
import ServicesList from "../components/ui/services-list.astro";

const page = await sanityClient.fetch(`*[_type=="services"][0]`);
---

<Layout>
  <OurServices {...page.blocks[0]} />
  <ServicesList />
  <div data-section="last">
    <div class="bg-white py-10 md:py-17 dark:bg-black">
      <h4
        data-text="title"
        class="mb-5 px-3 font-serif text-title-sm md:mb-10 md:px-5"
      >
        Alcuni dei nostri progetti
      </h4>
      <ProjectsSlider />
    </div>
    <div class="bg-white md:py-28 dark:bg-black">
      <ContactUs />
    </div>
  </div>
</Layout>

---
import Logo from "../../assets/logo.svg";
import Glyph from "../../assets/glyph.svg";
import Logotype from "../../assets/logotype.svg";
import ThemeSwitcher from "../global/theme-switcher.astro";
import clsx from "clsx";

const { pathname } = Astro.url;
---

<header
  class="peer sticky top-0 z-30 border-b border-current bg-white px-3 py-3 text-body-rem md:px-5 md:py-3.5 dark:bg-black"
>
  <div
    style="transform: translateY(-120%);"
    class="header-content flex items-center justify-between"
  >
    <a
      href="/"
      aria-label="homepage"
      class="transition-transform not-md:hidden hover:scale-105"
    >
      <Logo class="w-33.25" />
    </a>
    <a href="/" class="md:hidden">
      <Glyph class="w-8 md:hidden" />
    </a>
    <ThemeSwitcher />
    <div class="hidden items-center gap-10 uppercase lg:flex">
      <nav class="contents">
        <ul class="flex items-center gap-10 font-semibold">
          <li
            data-nav-item="about"
            data-current={pathname.includes("about")}
            class={clsx("group relative data-[current='true']:font-bold")}
          >
            <a href="/about">about</a>
            <span
              class="absolute -bottom-0.5 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100 group-data-[current='true']:scale-x-100"
            ></span>
          </li>
          <li
            data-nav-item="services"
            data-current={pathname.includes("services")}
            class={clsx("group relative data-[current='true']:font-bold")}
          >
            <a href="/services">servizi</a>
            <span
              class="absolute -bottom-0.5 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100 group-data-[current='true']:scale-x-100"
            ></span>
          </li>
          <li
            data-nav-item="portfolio"
            data-current={pathname.includes("portfolio")}
            class={clsx("group relative data-[current='true']:font-bold")}
          >
            <a href="/portfolio">portfolio</a>
            <span
              class="absolute -bottom-0.5 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100 group-data-[current='true']:scale-x-100"
            ></span>
          </li>
        </ul>
      </nav>
      <button
        data-newsletter-trigger
        class="cursor-pointer rounded-full border px-3.5 py-2 font-semibold uppercase transition-colors hover:bg-black hover:text-white dark:hover:bg-accent dark:hover:text-black"
        >newsletter</button
      >
    </div>
    <div class="lg:hidden">
      <label for="mobile-menu-open" class="font-semibold uppercase">
        <input
          type="radio"
          name="mobile-menu-toggle"
          id="mobile-menu-open"
          class="sr-only"
        />
        Menu
      </label>
    </div>
  </div>
</header>

<aside
  class="fixed top-0 -left-full z-40 flex h-dvh w-full flex-col bg-black px-3 py-1 text-white transition-transform duration-500 peer-has-[#mobile-menu-open:checked]:translate-x-full lg:hidden dark:bg-accent dark:text-black"
>
  <div class="flex items-center justify-between py-3">
    <Logotype class="w-20" />
    <label for="mobile-menu-close" class="font-semibold uppercase">
      <input
        type="radio"
        name="mobile-menu-toggle"
        id="mobile-menu-close"
        class="sr-only"
      />
      ✕
    </label>
  </div>
  <div class="mt-12 flex min-h-0 grow justify-center overflow-auto">
    <div class="space-y-12 font-serif text-[4.7rem] leading-[0.8] capitalize">
      <nav>
        <ul class="space-y-12 text-center">
          <li>
            <a class="mobile-link" href="/">home</a>
          </li>
          <li>
            <a class="mobile-link" href="/about">about</a>
          </li>
          <li>
            <a class="mobile-link" href="/services">servizi</a>
          </li>
          <li>
            <a class="mobile-link" href="/portfolio">portfolio</a>
          </li>
        </ul>
      </nav>
      <button data-newsletter-trigger class="mobile-link capitalize italic"
        >newsletter</button
      >
    </div>
  </div>
</aside>

<script>
  import { animate, type AnimationSequence } from "motion";

  const mobClose = document.getElementById(
    "mobile-menu-close"
  ) as HTMLInputElement;
  const mobLinks = document.querySelectorAll<HTMLElement>(".mobile-link");

  function init() {
    const sequence: AnimationSequence = [
      [".header-content", { y: 0 }, { duration: 0.7 }],
    ];

    animate(sequence);

    mobLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobClose.click();
      });
    });
  }
  init();
</script>

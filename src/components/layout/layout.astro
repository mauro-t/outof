---
import "../../styles.css";
import Header from "./header.astro";
import Footer from "./footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Out of</title>
    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            matchMedia("(prefers-color-scheme: dark)").matches)
      );
    </script>
  </head>
  <body
    class="bg-white text-body-sm text-black antialiased dark:bg-black dark:text-accent"
  >
    <Header />
    <div id="content">
      <main id="swup" class="relative z-10 bg-white dark:bg-black">
        <slot />
      </main>
      <div id="footer-space" class="h-(--footer-height)"></div>
      <Footer />
    </div>
    <div
      id="page-transition-layer"
      style="transform: translateY(100%);"
      class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center overflow-hidden"
    >
      <svg
        style="height: 100vmax; transform: scaleX(0.01);"
        class="flex-none"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 352 301"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <path
          d="M0 0 L352 0 L352 301 L0 301 Z"
          class="fill-black dark:fill-accent"></path>
      </svg>
    </div>
  </body>
  <script>
    import Lenis from "lenis";
    import Swup from "swup";

    import { lazyLoad } from "../../lib/lazy-load";
    import { initSwiper } from "../../lib/swiper";
    import { animateLayerIn, animateLayerOut } from "../../animations/layout";
    import { animateSections } from "../../animations/animate-sections";
    import animateText from "../../animations/animate-text";

    new Lenis({
      autoRaf: true,
    });

    const swup = new Swup({ animationSelector: "" });
    const footer = document.querySelector<HTMLElement>("footer")!;
    const footerSpace = document.getElementById("footer-space");

    function setFooterSpace() {
      footerSpace?.style.setProperty(
        "--footer-height",
        `${footer?.getBoundingClientRect().height}px`
      );
    }

    new ResizeObserver(setFooterSpace).observe(footer);
    setFooterSpace();

    swup.hooks.on("page:view", () => {
      animateSections();
      animateText();
      lazyLoad();
      initSwiper();
    });

    swup.hooks.on("animation:out:await", animateLayerIn);
    swup.hooks.on("animation:in:await", animateLayerOut);

    animateSections();
    animateText();
    lazyLoad();
    initSwiper();
  </script>
</html>

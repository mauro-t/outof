---
import "../../styles.css";
import "swiper/css";
import "swiper/css/pagination";

import { sanityClient } from "sanity:client";

import Header from "./header.astro";
import Footer from "./footer.astro";
import PopupNewsletter from "../ui/popup-newsletter.astro";
import PopupEcoview from "../ui/popup-ecoview.astro";

const general = await sanityClient.fetch(`*[_type=="general"][0]{
  ...,
  newsletter_popup{
    title,
    description,
    background_video{
      asset->{
        url
      }
    }
  }
}`);
---

<html lang="en" class="scrollbar-none overscroll-none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Out Of</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Out Of" />
    <meta property="og:image" content="" />
    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            matchMedia("(prefers-color-scheme: dark)").matches)
      );
    </script>
  </head>
  <body
    class="overscroll-none bg-white text-body-sm text-black antialiased dark:bg-black dark:text-accent"
  >
    <Header />
    <div id="content" style="opacity: 0;">
      <main id="swup" class="relative z-10 bg-white dark:bg-black">
        <slot />
      </main>
      <div id="footer-space" class="h-(--footer-height)"></div>
      <Footer content={general.footer} />
    </div>
    <div
      id="page-transition-layer"
      style="transform: translateY(100%);"
      class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center overflow-hidden"
    >
      <svg
        style="height: 100vmax;"
        class="flex-none"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 352 301"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <path
          d="M0 0 L352 0 L352 301 L0 301 Z"
          class="fill-black dark:fill-accent"></path>
      </svg>
    </div>
    <PopupNewsletter content={general.newsletter_popup} />
    <PopupEcoview content={general.ecoview_popup} />
  </body>
  <script>
    import Lenis from "lenis";
    import Swup from "swup";

    import { lazyLoad } from "../../lib/lazy-load";
    import { initSwipers } from "../../lib/swiper";
    import { animateLayerIn, animateLayerOut } from "../../animations/layout";
    import { animateSections } from "../../animations/animate-sections";
    import animateText from "../../animations/animate-text";
    import { animate } from "motion";

    declare global {
      interface Window {
        lenis?: Lenis; // or whatever type you need
      }
    }

    const lenis = new Lenis({
      autoRaf: true,
    });

    window.lenis = lenis;

    const swup = new Swup({ animationSelector: "" });
    const footer = document.querySelector<HTMLElement>("footer")!;
    const footerSpace = document.getElementById("footer-space");

    const navItems = document.querySelectorAll<HTMLElement>("[data-nav-item]");

    function setFooterSpace() {
      footerSpace?.style.setProperty(
        "--footer-height",
        `${footer?.getBoundingClientRect().height}px`
      );
    }

    new ResizeObserver(setFooterSpace).observe(footer);
    setFooterSpace();

    swup.hooks.on("page:view", (view) => {
      navItems.forEach((item) => {
        const current = view.to.url;
        if (current.includes(item.dataset.navItem!)) {
          item.dataset.current = "true";
        } else {
          item.dataset.current = "false";
        }
      });

      animateSections();
      animateText();
      lazyLoad();
      initSwipers();
    });

    swup.hooks.on("animation:out:await", animateLayerIn);
    swup.hooks.on("animation:in:await", animateLayerOut);

    animateSections();
    animateText();
    lazyLoad();
    initSwipers();

    document.addEventListener("DOMContentLoaded", () => {
      animate("#content", { opacity: 1 }, { duration: 1.55 });
    });
  </script>
</html>

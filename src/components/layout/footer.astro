---
import O from "../../assets/O.svg";
import U from "../../assets/u.svg";
import T from "../../assets/t.svg";
import F from "../../assets/f.svg";

type Props = {
  content: {
    contacts: {
      email?: string;
      phone?: string;
    };
    social: {
      name: string;
      link: string;
    }[];
  };
};

const {
  content: { contacts, social },
} = Astro.props;
---

<footer
  class="fixed bottom-0 w-full bg-black pt-40 pb-8 text-body-rem font-semibold text-white dark:bg-accent dark:text-black"
>
  <div class="px-3 pb-3 md:px-5 xl:hidden">
    {
      contacts.email && (
        <a class="block" href={`mailto:${contacts.email}`}>
          Email
        </a>
      )
    }
    {
      social.map((s) => (
        <a
          class="block"
          target="_blank"
          rel="noopener noreferrer"
          href={`${s.link}`}
        >
          {s.name}
        </a>
      ))
    }
    <button data-newsletter-trigger class="block cursor-pointer text-left"
      >Newsletter</button
    >
  </div>
  <div class="flex items-end justify-center gap-[1%]">
    <div class="relative w-[22.78%]">
      <O />
      <div
        class="absolute top-0 right-0 hidden w-max translate-x-full items-end xl:flex"
      >
        <div class="pl-[2vw]">
          {
            contacts.email && (
              <a
                class="group relative block w-fit"
                href={`mailto:${contacts.email}`}
              >
                Email
                <span class="absolute bottom-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
              </a>
            )
          }
          {
            social.map((s) => (
              <a
                class="group relative block w-fit"
                target="_blank"
                rel="noopener noreferrer"
                href={`${s.link}`}
              >
                {s.name}
                <span class="absolute bottom-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
              </a>
            ))
          }
          <button
            data-newsletter-trigger
            class="group relative block w-fit cursor-pointer text-left"
            >Newsletter
            <span
              class="absolute bottom-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100"
            ></span></button
          >
        </div>
      </div>
      <div class="absolute bottom-0 left-[55%] w-max text-[12px] not-xl:hidden">
        Design by <a
          href="http://www.irenesalvadeo.com/"
          target="_blank"
          rel="noopener noreferrer">Irene</a
        >. Developed by <a
          href="https://www.mauro.ooo/"
          target="_blank"
          rel="noopener noreferrer">Mauro</a
        >
      </div>
    </div>
    <div class="w-[20.28%]">
      <U />
    </div>
    <div class="w-[11.11%]">
      <T />
    </div>
    <div class="w-[22.78%]">
      <O />
    </div>
    <div class="relative w-[14.17%]">
      <F />
      <span
        class="absolute bottom-0 -left-[6%] hidden -translate-x-full xl:inline-block"
        >© 2025 Out Of</span
      >
    </div>
  </div>
  <div
    class="mt-3 flex items-end justify-between gap-6 px-3 md:mt-6 md:px-6 xl:hidden"
  >
    <span>
      Design by <a
        href="http://www.irenesalvadeo.com/"
        target="_blank"
        rel="noopener noreferrer">Irene</a
      >. <br class="block sm:hidden" /> Developed by <a
        href="https://www.mauro.ooo/"
        target="_blank"
        rel="noopener noreferrer">Mauro</a
      >.</span
    >
    <span class="whitespace-nowrap">© 2025 Out Of</span>
  </div>
</footer>

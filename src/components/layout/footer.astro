---
import O from "../../assets/O.svg";
import U from "../../assets/u.svg";
import T from "../../assets/t.svg";
import F from "../../assets/f.svg";

type Props = {
  content: {
    address: string[];
    vat: string;
    contacts: {
      email?: string;
      phone?: string;
    };
    social: {
      name: string;
      link: string;
    }[];
  };
};

const {
  content: { address, vat, contacts, social },
} = Astro.props;
---

<footer
  class="fixed bottom-0 w-full bg-black pt-40 pb-8 text-body-rem text-white dark:bg-accent dark:text-black"
>
  <div class="px-3 pb-3 md:px-5 xl:hidden">
    <div>
      {address?.map((line) => <div>{line}</div>)}
      <div>P.IVA {vat}</div>
    </div>
    <div class="mt-6 flex items-end justify-between">
      <div>
        {
          contacts?.email && (
            <a
              href={`mailto:${contacts.email}`}
              class="group relative w-fit cursor-pointer"
            >
              Email
              <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
            </a>
          )
        }
        {
          contacts?.phone && (
            <a
              href={`tel:${contacts.phone}`}
              class="group relative w-fit cursor-pointer"
            >
              Telefono
              <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
            </a>
          )
        }
      </div>
      <div>
        {
          social?.map((s) => (
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={s.link}
              class="group relative w-fit cursor-pointer"
            >
              {s.name}
              <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
            </a>
          ))
        }

        <div
          data-newsletter-trigger
          class="group relative w-fit cursor-pointer"
        >
          Newsletter
          <span
            class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100"
          ></span>
        </div>
      </div>
      <div>© 2025 Out Of</div>
    </div>
  </div>
  <div class="flex items-end justify-center gap-[1%]">
    <div class="relative w-[22.78%]">
      <O />
      <div
        class="absolute top-0 right-0 hidden w-max translate-x-full items-end xl:flex"
      >
        <div class="whitespace-nowrap">
          {address.map((line) => <div>{line}</div>)}
          <div>P.IVA {vat}</div>
        </div>
        <div class="pl-[2vw]">
          {
            contacts?.email && (
              <a
                href={`mailto:${contacts.email}`}
                class="group relative w-fit cursor-pointer"
              >
                Email
                <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
              </a>
            )
          }
          {
            contacts?.phone && (
              <a
                href={`tel:${contacts.phone}`}
                class="group relative w-fit cursor-pointer"
              >
                Telefono
                <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
              </a>
            )
          }
        </div>
        <div class="pl-[12vw]">
          {
            social?.map((s) => (
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={s.link}
                class="group relative w-fit cursor-pointer"
              >
                {s.name}
                <span class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100" />
              </a>
            ))
          }
          <div
            data-newsletter-trigger
            class="group relative w-fit cursor-pointer"
          >
            Newsletter
            <span
              class="absolute bottom-0 left-0 block h-px w-full origin-left scale-x-0 bg-current transition-transform group-hover:scale-x-100"
            ></span>
          </div>
        </div>
      </div>
    </div>
    <div class="w-[20.28%]">
      <U />
    </div>
    <div class="w-[11.11%]">
      <T />
    </div>
    <div class="w-[22.78%]">
      <O />
    </div>
    <div class="relative w-[14.17%]">
      <F />
      <span
        class="absolute bottom-0 -left-[6%] hidden -translate-x-full xl:inline-block"
        >© 2025 Out Of</span
      >
    </div>
  </div>
</footer>

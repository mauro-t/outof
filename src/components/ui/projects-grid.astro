---
import { sanityClient } from "sanity:client";

const projects = await sanityClient.fetch(`*[_type == "project"]{
  title,
  talents,
  "slug": slug.current,
  listing_image{
    asset->{
      url,
      metadata {
        dimensions {
          aspectRatio
        },
      },
    }
  }
}`);

import ProjectCard from "./project-card.astro";
import clsx from "clsx";

const rows = [
  { values: [0, 1], justify: "justify-start" },
  { values: [2, 3], justify: "justify-end" },
  { values: [4, 5], justify: "justify-start" },
  { values: [6], justify: "justify-center" },
  { values: [7, 8], justify: "justify-between" },
];
---

<div class="space-y-5 p-3 md:space-y-17 md:p-5">
  {
    rows.map((row) => (
      <div
        class={clsx(
          "row flex flex-col gap-5 md:h-120 md:flex-row md:gap-2",
          row.justify
        )}
      >
        {row.values.map((item) => (
          <div class="flex not-md:*:w-full">
            <ProjectCard {...projects[item]} />
          </div>
        ))}
      </div>
    ))
  }
</div>

---
import { sanityClient } from "sanity:client";

const projects =
  await sanityClient.fetch(`*[_type == "project"]|order(orderRank){
  title,
  talents,
  "slug": slug.current,
  listing_image{
    asset->{
      url,
      metadata {
        dimensions {
          aspectRatio
        },
      },
    }
  }
}`);

const grid = await sanityClient.fetch(`*[_type == "projects-grid"]{
  rows[]{
    align,
    projects[]->{
      title,
      main_service,
      "slug": slug.current,
      listing_image{
        asset->{
          url,
          metadata {
            dimensions {
              aspectRatio
            },
          },
        }
      }
    }
  }
}[0]`);
const gridProjects = grid.rows.flatMap((r: any) => r.projects);
const missingProjects = projects.filter(
  (p: any) => !gridProjects.some((gP: any) => gP.slug == p.slug)
);

import ProjectCard from "./project-card.astro";
import clsx from "clsx";

const rowAlign = {
  left: "justify-start",
  right: "justify-end",
  center: "justify-center",
  between: "justify-between",
};
---

<div class="space-y-5 p-3 md:space-y-17 md:p-5">
  {
    grid.rows.map((row: any) => (
      <div
        class={clsx(
          "row flex flex-col gap-5 md:h-120 md:flex-row md:gap-2",
          rowAlign[row.align as keyof typeof rowAlign]
        )}
      >
        {row.projects.map((item: any) => (
          <div class="flex not-md:*:w-full">
            <ProjectCard {...item} />
          </div>
        ))}
      </div>
    ))
  }
  {
    missingProjects.length && (
      <div
        class={clsx(
          "row flex flex-col flex-wrap gap-5 md:h-120 md:flex-row md:gap-2"
        )}
      >
        {missingProjects.map((item: any) => (
          <div class="flex not-md:*:w-full">
            <ProjectCard {...item} />
          </div>
        ))}
      </div>
    )
  }
</div>

---
import NewsletterBox from "./newsletter-box.astro";

type Props = {
  content: {
    title: string;
    description: string;
    background_video: {
      asset: {
        url: string;
      };
    };
  };
};

const { content } = Astro.props;
---

<div
  data-ts="popup-newsletter"
  aria-label="close popup"
  id="newsletter-popup"
  style="opacity: 0; pointer-events: none;"
  class="fixed inset-0 z-50 flex h-svh items-center justify-center bg-black/25 p-3 md:p-5"
>
  <div
    class="relative flex aspect-33/40 w-full max-w-[33.75rem] items-center justify-center overflow-hidden rounded-3xl px-3"
  >
    <video
      data-nl-video
      src={content.background_video.asset.url}
      loop
      autoplay
      playsinline
      muted
      class="absolute inset-0 h-full w-full object-cover"></video>
    <button data-newsletter-close class="absolute top-5 right-5 cursor-pointer"
      ><svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="none"
      >
        <path
          class="fill-white dark:fill-accent"
          d="M3.26659 27.4166L0.583252 24.7333L11.3166 13.9999L0.583252 3.26659L3.26659 0.583252L13.9999 11.3166L24.7333 0.583252L27.4166 3.26659L16.6833 13.9999L27.4166 24.7333L24.7333 27.4166L13.9999 16.6833L3.26659 27.4166Z"
        ></path>
      </svg></button
    >
    <div class="relative">
      <NewsletterBox title={content.title} description={content.description} />
    </div>
  </div>
</div>

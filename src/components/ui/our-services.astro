---
import FloatingEllipses from "./floating-ellipses.astro";

type Props = {
  isHomepage?: boolean;
};

const { isHomepage } = Astro.props;
const TitleTag = isHomepage ? "h2" : "h1";
---

<div
  data-section="short"
  class="relative flex h-hero w-full flex-col items-center justify-center bg-black p-6 text-white md:aspect-9/4 md:h-auto dark:bg-accent dark:text-black"
>
  <FloatingEllipses />
  <div class="relative overflow-hidden">
    <TitleTag data-text="title" class="text-center font-serif text-title-2xl"
      >I nostri servizi</TitleTag
    >
  </div>
  <p
    data-text="body"
    class="relative mt-6 max-w-174 text-center text-body-md md:mt-12"
  >
    Strategia, creatività e produzione si uniscono per accompagnare progetti che
    vogliono lasciare un segno, non solo un'impressione.
  </p>
  {
    isHomepage && (
      <div class="mt-8">
        <a
          href="/services"
          class="group relative inline-flex items-center gap-1.5"
        >
          scopri di più{" "}
          <div class="overflow-hidden">
            <span class="inline-block -translate-x-full transition-transform duration-500 group-hover:translate-x-0">
              +
            </span>
          </div>
          <span class="absolute -bottom-1 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform duration-500 group-hover:scale-x-100" />
        </a>
      </div>
    )
  }
</div>

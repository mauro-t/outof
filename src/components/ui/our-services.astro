---
import clsx from "clsx";
import { sectionBg } from "../../lib/section-bg";

import FloatingEllipses from "./floating-ellipses.astro";
import Mask from "../global/mask.astro";

type Props = {
  background: "light" | "dark" | "ellipses" | "mask" | "mask-not-inverted";
  content: { cta: string; description: string; title: string };
  isHomepage?: boolean;
};

const { isHomepage, background, content } = Astro.props;
const TitleTag = isHomepage ? "h2" : "h1";
---

<div
  class={clsx(
    "relative flex h-hero w-full flex-col items-center justify-center p-6 md:aspect-9/4 md:h-auto",
    sectionBg(background)
  )}
>
  {background == "ellipses" && <FloatingEllipses />}
  {
    (background == "mask" || background == "mask-not-inverted") && (
      <Mask invert={background == "mask"} />
    )
  }
  <div class="relative overflow-hidden">
    <TitleTag data-text="title" class="text-center font-serif text-title-2xl"
      >{content?.title}</TitleTag
    >
  </div>
  <p
    data-text="body"
    class="relative mt-6 max-w-174 text-center text-body-md md:mt-12"
  >
    {content?.description}
  </p>
  {
    content?.cta && (
      <div class="mt-8">
        <a
          href="/services"
          class="group relative inline-flex items-center gap-1.5"
        >
          {content.cta}{" "}
          <div class="overflow-hidden">
            <span class="inline-block -translate-x-full transition-transform duration-500 group-hover:translate-x-0">
              +
            </span>
          </div>
          <span class="absolute -bottom-1 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform duration-500 group-hover:scale-x-100" />
        </a>
      </div>
    )
  }
</div>

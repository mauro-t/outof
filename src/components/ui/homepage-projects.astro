---
import clsx from "clsx";
import ProjectPreview from "./project-preview.astro";
import { sectionBg } from "../../lib/section-bg";
import FloatingEllipses from "./floating-ellipses.astro";
import Mask from "../global/mask.astro";

type Props = {
  background: "light" | "dark" | "ellipses" | "mask" | "mask-not-inverted";
  title: string;
  cta: string;
  projects: any[];
};

const { title, cta, projects, background } = Astro.props;
---

<div class={clsx("p-3 py-17 md:p-5 md:py-22", sectionBg(background))}>
  {background == "ellipses" && <FloatingEllipses />}
  {
    (background == "mask" || background == "mask-not-inverted") && (
      <Mask invert={background == "mask"} />
    )
  }
  <div class="relative">
    <h4 class="text-center">{title}</h4>
    <div
      data-ts="project-previews"
      class="mt-6 space-y-5 md:mt-12 md:space-y-7.5"
    >
      {projects.map((project: any) => <ProjectPreview {...project} />)}
    </div>
    <div class="mt-8 text-center">
      <a
        href="/portfolio"
        class="group relative inline-flex items-center gap-1.5"
      >
        {cta}
        <div class="overflow-hidden">
          <span
            class="inline-block -translate-x-full transition-transform duration-500 group-hover:translate-x-0"
            >+</span
          >
        </div>
        <span
          class="absolute -bottom-1 left-0 h-0.5 w-full origin-left scale-x-0 bg-current transition-transform duration-500 group-hover:scale-x-100"
        >
        </span>
      </a>
    </div>
  </div>
</div>

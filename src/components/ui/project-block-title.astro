---
type Props = {
  title: string;
  talents: string[];
};
const { title, talents } = Astro.props;
let talent = "";

if (talents.length > 2) {
  talent = "Multitalent";
} else {
  talent = talents.join(" & ");
}
---

<div class="px-3 pt-10 md:px-5 md:pt-17">
  <h1 class="font-serif text-title-md">
    <div>
      {title}
    </div>
    <div class="italic">{talent}</div>
  </h1>
</div>

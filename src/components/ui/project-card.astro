---
import SanityImage from "../global/sanity-image.astro";

type Props = {
  slug: string;
  title: string;
  main_service: string;
  listing_image?: any;
};
const { slug, title, main_service, listing_image } = Astro.props;

const aspectRatio = listing_image.asset.metadata.dimensions.aspectRatio;
---

<a
  data-project-card
  style="opacity: 0;"
  href={`/portfolio/${slug}`}
  class="group flex h-full w-fit flex-none flex-col"
>
  <div
    style={{ aspectRatio, clipPath: "inset(100% 0 0 0)" }}
    class="relative h-full min-h-0 overflow-hidden"
  >
    <SanityImage
      image={listing_image}
      className="absolute inset-0 h-full w-full object-cover transition-[scale,filter] duration-500 group-hover:scale-110 group-hover:brightness-110 group-hover:saturate-110"
    />
  </div>
  <p class="mt-3 text-body-rem font-semibold">
    <span class="block">{title}</span>
    <span class="block italic">{main_service}</span>
  </p>
</a>

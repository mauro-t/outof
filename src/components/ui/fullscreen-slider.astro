---
import type { SanityImageAssetDocument } from "@sanity/client";
import { urlFor } from "../../lib/sanity";

type Props = {
  images: SanityImageAssetDocument[];
};

const imgs = Astro.props.images.map((i) => urlFor(i).width(2048).url());
---

<div
  class="swiper-fullscreen relative my-3 h-[60svh] overflow-hidden md:h-[calc(100svh-var(--header-height)-24px)]"
>
  <div class="swiper-wrapper">
    {
      imgs.map((img) => (
        <div class="swiper-slide relative">
          <div class="relative h-full w-[calc(100%-24px)] md:w-[calc(100%-40px)]">
            <img
              src={img}
              class="absolute inset-0 h-full w-full object-cover"
              alt=""
            />
          </div>
        </div>
      ))
    }
  </div>
  <div
    class="swiper-pagination !bottom-5 flex items-center gap-3 !px-10 !text-left not-md:!bottom-7"
  >
  </div>
</div>

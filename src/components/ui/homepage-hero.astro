---
type Props = {
  outof: { label: string; paragraph: string }[];
};

import LogoHtml from "../global/logo-html.astro";

const { outof } = Astro.props;
---

<div
  data-ts="homepage-hero"
  data-section
  class="flex h-hero flex-col items-center justify-center p-3 md:p-5"
>
  <div
    class="inline-grid grid-cols-1 grid-rows-2 font-serif text-title-2xl leading-none md:grid-cols-2 md:grid-rows-1 md:gap-8"
  >
    <div class="w-fit justify-self-center">
      <LogoHtml />
    </div>
    <div class="relative w-[5ch] text-center italic md:text-left">
      <div id="title-words" class="absolute inset-0">
        {outof.map(({ label }) => <div class="absolute inset-0">{label}</div>)}
      </div>
    </div>
  </div>
  <div
    id="title-paragraphs"
    class="mt-12 grid grid-cols-1 grid-rows-1 text-center"
  >
    {
      outof.map(({ paragraph }, i) => (
        <p class="col-start-1 row-start-1 inline-block max-w-174 text-body-md">
          {paragraph}
        </p>
      ))
    }
  </div>
</div>

---
import clsx from "clsx";
import { sectionBg } from "../../lib/section-bg";
import FloatingEllipses from "./floating-ellipses.astro";
import Mask from "../global/mask.astro";

type Props = {
  background: "light" | "dark" | "ellipses" | "mask" | "mask-not-inverted";
  list: {
    title: string;
    sub: {
      sub_title: string;
      services: string[];
    }[];
  }[];
};

const { background, list } = Astro.props;
---

<div
  class={clsx("relative px-3 py-10 md:px-5 md:py-17", sectionBg(background))}
>
  {background == "ellipses" && <FloatingEllipses />}
  {
    (background == "mask" || background == "mask-not-inverted") && (
      <Mask invert={background == "mask"} />
    )
  }
  <div class="relative">
    {
      list.map(({ title, sub }) => (
        <div class="grid grid-cols-1 items-start not-md:mt-12 md:grid-cols-2 md:gap-[calc(1/12*100%)] md:first:pb-17">
          <h3
            data-text="title"
            class="font-serif text-title-md md:sticky md:top-[calc(var(--header-height)+1.5rem)]"
          >
            {title}
          </h3>
          <div class="space-y-12">
            {sub.map(({ sub_title, services }) => (
              <div>
                <h4 data-text="body" class="mt-6 text-body-lg">
                  {sub_title}
                </h4>
                <ul class="mt-6 list-['⬝'] space-y-2 pl-[0.75em]">
                  {services.map(
                    (item) =>
                      item && (
                        <li
                          data-text="body"
                          class="pl-[0.25em] text-body-md leading-[1.6]"
                        >
                          {item}
                        </li>
                      )
                  )}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

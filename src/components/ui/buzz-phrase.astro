---
import clsx from "clsx";

type Props = {
  content: { value: string; align: "right" | "left" | "center" }[];
};

const { content } = Astro.props;

const alignments = {
  left: "text-left",
  right: "text-right",
  center: "text-center",
};

const lines =
  content?.map((line) => ({
    align: alignments[line.align],
    value: line.value.replace(
      "OutOf",
      "<div class='font-serif inline-block'><span class='italic'>O</span>ut<span class='italic'>O</span>f</div>"
    ),
  })) ?? [];
---

<div class="relative font-serif text-title-buzzphrase leading-none">
  {
    lines.map((line) => (
      <>
        <div
          class={clsx("contents md:block", line.align)}
          set:html={line.value}
        />
      </>
    ))
  }
</div>

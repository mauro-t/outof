---
import SanityImage from "../global/sanity-image.astro";

type Props = {
  content: {
    title: string;
    description: string;
    background_image: any;
  };
};

const { content } = Astro.props;
---

<div
  data-ts="popup-ecoview"
  id="ecoview-popup"
  style="opacity: 0; pointer-events: none;"
  class="fixed inset-0 z-50 flex h-svh items-center justify-center bg-black/25 p-3 md:p-5"
>
  <div
    class="relative flex aspect-33/40 w-full max-w-[33.75rem] items-center justify-center overflow-hidden rounded-3xl px-3"
  >
    <SanityImage
      image={content.background_image}
      className="absolute inset-0 h-full w-full object-cover"
    />
    <button data-ecoview-close class="absolute top-5 right-5 cursor-pointer"
      ><svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="none"
      >
        <path
          class="fill-white dark:fill-accent"
          d="M3.26659 27.4166L0.583252 24.7333L11.3166 13.9999L0.583252 3.26659L3.26659 0.583252L13.9999 11.3166L24.7333 0.583252L27.4166 3.26659L16.6833 13.9999L27.4166 24.7333L24.7333 27.4166L13.9999 16.6833L3.26659 27.4166Z"
        ></path>
      </svg></button
    >
    <div class="relative">
      <div
        class="max-w-116 rounded-3xl bg-white/20 px-6 py-7 text-white backdrop-blur-[6px] dark:text-accent"
      >
        <h3 class="font-serif text-title-sm">{content.title}</h3>
        <div data-animation="by-line" class="my-7">
          {content.description}
        </div>
        <label
          for="theme-switcher-popup"
          class="inline-flex cursor-pointer flex-col items-center justify-center gap-0.5 text-body-rem md:flex-row md:gap-2.5"
        >
          <input
            type="checkbox"
            name="theme-switcher"
            id="theme-switcher-popup"
            class="peer sr-only"
          />
          <span
            class="group relative h-6.5 w-16.5 rounded-full border md:h-9.5 md:w-20"
          >
            <span
              class="absolute top-1/2 left-2 -translate-y-1/2 font-semibold uppercase opacity-0 transition-opacity group-peer-checked:opacity-100"
              >on</span
            >
            <span
              class="absolute top-1/2 right-2 -translate-y-1/2 font-semibold uppercase transition-opacity group-peer-checked:opacity-0"
              >off</span
            >
            <span
              class="absolute top-0.5 left-0.5 aspect-square h-[calc(100%-0.25rem)] rounded-full bg-current transition-[translate,left] group-peer-checked:left-[calc(100%-0.25rem)] group-peer-checked:-translate-x-full md:top-1 md:left-1 md:h-[calc(100%-0.5rem)] md:group-peer-checked:left-[calc(100%-0.25rem)]"
            ></span>
          </span>
        </label>
      </div>
    </div>
  </div>
</div>
<script>
  const themeSwitcherPopup = document.getElementById(
    "theme-switcher-popup"
  ) as HTMLInputElement;

  const themeSwitcher = document.getElementById("theme-switcher");

  themeSwitcherPopup.addEventListener("change", () => {
    themeSwitcher?.click();
  });

  themeSwitcherPopup.checked =
    localStorage.theme === "dark" ||
    (!("theme" in localStorage) &&
      matchMedia("(prefers-color-scheme: dark)").matches);
</script>

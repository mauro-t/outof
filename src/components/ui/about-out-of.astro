---
import outOf from "../../assets/mock-data/out-of.json";
---

<div
  data-section="last"
  class="grid grid-cols-1 gap-10 bg-white px-3 py-10 md:grid-cols-3 md:px-5 md:py-17 dark:bg-black"
>
  {
    outOf
      .map((oo) => ({ ...oo, title: oo.title.replace("OutOf ", "") }))
      .map(({ title, body }) => (
        <div class="not-md:text-center">
          <h4 class="overflow-hidden font-serif text-title-sm">
            <div>
              <span class="italic">OutOf</span>&nbsp;&nbsp;{title}
            </div>
          </h4>
          <p class="mt-2">{body}</p>
        </div>
      ))
  }
</div>


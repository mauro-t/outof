---
type Props = {
  content: { label: string; paragraph: string }[];
};

const { content } = Astro.props;
---

<div
  data-section="last"
  class="grid grid-cols-1 gap-10 bg-white px-3 py-10 md:grid-cols-3 md:px-5 md:py-17 dark:bg-black"
>
  {
    content.map(({ label, paragraph }) => (
      <div class="not-md:text-center">
        <h4 class="overflow-hidden font-serif text-title-sm">
          <div data-text="title">
            <span class="italic">OutOf</span>
            <span class="pl-[0.5rem]">{label}</span>
          </div>
        </h4>
        <p data-text="body" class="mt-2">
          {paragraph}
        </p>
      </div>
    ))
  }
</div>

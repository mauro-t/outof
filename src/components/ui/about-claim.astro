---
import clsx from "clsx";
import { sectionBg } from "../../lib/section-bg";
import Mask from "../global/mask.astro";
import FloatingEllipses from "./floating-ellipses.astro";

type Props = {
  background: "light" | "dark" | "ellipses" | "mask" | "mask-not-inverted";
  paragraph: string;
};

const { background, paragraph } = Astro.props;
---

<div
  class={clsx(
    "relative flex h-hero items-center justify-center p-3 md:p-5",
    sectionBg(background)
  )}
>
  {
    (background == "mask" || background == "mask-not-inverted") && (
      <Mask invert={background == "mask"} />
    )
  }
  {background == "ellipses" && <FloatingEllipses />}
  <p class="max-w-135 text-center">
    {paragraph}
  </p>
</div>
